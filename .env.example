# Sao chép thành .env rồi chỉnh sửa (docker compose tự đọc file .env)
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
# Cổng PostgreSQL phía máy host (5432 thường đã bị PostgreSQL cài sẵn chiếm)
POSTGRES_HOST_PORT=5433
# Số kết nối DB tối đa mỗi service (13 service dùng chung một PostgreSQL có max_connections=200)
DB_POOL_SIZE=5

# Bí mật ký JWT, dùng chung cho auth-service và api-gateway (tối thiểu 32 ký tự)
JWT_SECRET=change-me-please-this-is-a-dev-only-secret-0123456789

# Saga: hủy đơn nếu sau thời gian này chưa giữ hàng + thanh toán xong (ISO-8601)
ORDER_TIMEOUT=PT2M

# Thanh toán mô phỏng: tỷ lệ bị từ chối ngẫu nhiên và độ trễ cổng thanh toán
PAYMENT_FAILURE_RATE=0.1
PAYMENT_DELAY_MS=50

# Ngưỡng cảnh báo của Analytics (số sự kiện / phút)
ORDER_SPIKE_THRESHOLD=30
PAYMENT_FAILURE_THRESHOLD=5

# Khách hàng ảo: tự chạy khi khởi động và số phiên mua sắm / phút
SIMULATOR_AUTOSTART=true
SIMULATOR_SESSIONS_PER_MINUTE=20

# Giới hạn bộ nhớ JVM cho mỗi service
JAVA_OPTS=-Xms64m -Xmx320m -XX:+UseSerialGC

# ---- Ecommerce 2.0 ----
# Fraud Service: tổng điểm rủi ro (và ≥ 2 tín hiệu) để đưa đơn vào xác minh thủ công
FRAUD_REVIEW_SCORE=70
# false → Order Service không chờ chấm điểm rủi ro (chạy được khi không bật fraud-service)
FRAUD_CHECK_ENABLED=true
# Đơn chờ xác minh rủi ro quá thời hạn này → tự hủy và hoàn kho
ORDER_REVIEW_TIMEOUT=PT30M

# ---- Ecommerce 2.1: Khuyến mãi + Bảo mật & vận hành ----
# false → Order Service không chờ Promotion Service định giá (không áp dụng flash sale / voucher)
PROMOTION_CHECK_ENABLED=true
# Tạo voucher mẫu (WELCOME10, FREESHIP, GIAM50K) và flash sale mẫu khi CSDL khuyến mãi còn trống
PROMOTION_SEED=true
# Rate limit ở API Gateway (request/phút). Đặt RATE_LIMIT_ENABLED=false khi chạy kiểm thử tải k6 cường độ cao
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=300
RATE_LIMIT_ORDERS_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=3000
# Sai mật khẩu N lần liên tiếp → tạm khóa đăng nhập trong khoảng thời gian này
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_DURATION=PT5M
# Mật khẩu tài khoản admin của Grafana (http://localhost:3001) – đổi khi triển khai thật
GRAFANA_PASSWORD=admin

# ---- Ecommerce 2.2: Cảnh báo qua email/chat + Hỗ trợ khách hàng ----
# Kênh nhận cảnh báo hệ thống (Prometheus → Alertmanager → notification-service). Để trống = tắt kênh đó.
ALERT_SLACK_WEBHOOK_URL=
ALERT_DISCORD_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Email cảnh báo: mặc định gửi vào Mailpit (xem tại http://localhost:8025). Đổi SMTP_* để gửi email thật,
# vd. Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_AUTH=true SMTP_STARTTLS=true + App Password
ALERT_EMAIL_TO=admin@shop.local
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
# Token Alertmanager gửi kèm webhook – đổi đồng thời ở infra/alertmanager/alertmanager.yml
ALERT_WEBHOOK_TOKEN=change-me-alert-webhook-token
# Thời hạn phản hồi đầu tiên cho yêu cầu hỗ trợ mức ưu tiên thường (ưu tiên cao 30 phút, khẩn 15 phút)
SUPPORT_SLA_NORMAL=PT2H

# ---- Ecommerce 2.3: Gợi ý sản phẩm + Dashboard khởi động nhanh ----
# Đơn hàng trong khoảng này sau khi khách bấm một sản phẩm được gợi ý → tính là đơn nhờ gợi ý
REC_ATTRIBUTION_WINDOW=24h
# false = Dashboard đọc lại toàn bộ analytics-events mỗi lần khởi động (hành vi trước 2.3)
DASHBOARD_SNAPSHOT_ENABLED=true
