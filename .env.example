# Sao chép thành .env rồi chỉnh sửa (docker compose tự đọc file .env)
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
# Cổng PostgreSQL phía máy host (5432 thường đã bị PostgreSQL cài sẵn chiếm)
POSTGRES_HOST_PORT=5433

# Bí mật ký JWT, dùng chung cho auth-service và api-gateway (tối thiểu 32 ký tự)
JWT_SECRET=change-me-please-this-is-a-dev-only-secret-0123456789

# Saga: hủy đơn nếu sau thời gian này chưa giữ hàng + thanh toán xong (ISO-8601)
ORDER_TIMEOUT=PT2M

# Thanh toán mô phỏng: tỷ lệ bị từ chối ngẫu nhiên và độ trễ cổng thanh toán
PAYMENT_FAILURE_RATE=0.1
PAYMENT_DELAY_MS=50

# Ngưỡng cảnh báo của Analytics (số sự kiện / phút)
ORDER_SPIKE_THRESHOLD=30
PAYMENT_FAILURE_THRESHOLD=5

# Khách hàng ảo: tự chạy khi khởi động và số phiên mua sắm / phút
SIMULATOR_AUTOSTART=true
SIMULATOR_SESSIONS_PER_MINUTE=20

# Giới hạn bộ nhớ JVM cho mỗi service
JAVA_OPTS=-Xms64m -Xmx320m -XX:+UseSerialGC
